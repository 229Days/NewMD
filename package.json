{
  "name": "newmd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "description": "A Typora-like Markdown editor — Tauri desktop shell with a web-first core.",
  "scripts": {
    "dev": "pnpm --filter @newmd/desktop dev",
    "dev:web": "pnpm --filter @newmd/desktop dev:web",
    "build": "pnpm --filter @newmd/desktop build",
    "preview": "pnpm --filter @newmd/desktop preview",
    "tauri": "pnpm --filter @newmd/desktop tauri",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
